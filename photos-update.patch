diff --git a/_data/photos.yml b/_data/photos.yml
index e244354..70c518b 100644
--- a/_data/photos.yml
+++ b/_data/photos.yml
@@ -3,11 +3,12 @@
 # 2. Add an entry below. section must be one of:
 #    music, kyoto, teaching, community, competitions
 # Sections with no photos show no gallery.
-# Delete the "[]" line once you add the first photo.
+# Browsers can't show .HEIC files, so use .jpg or .png.
 #
 # Example:
 # - file: band-rose-bowl.jpg
 #   caption: "Pregame at the Rose Bowl, 2024"
 #   section: music
 
-[]
+- file: marchingband.jpg
+  section: music
diff --git a/_includes/gallery.html b/_includes/gallery.html
index 76f5405..6710764 100644
--- a/_includes/gallery.html
+++ b/_includes/gallery.html
@@ -1,9 +1,9 @@
 {% assign photos = site.data.photos | where: "section", include.section %}
 {% if photos.size > 0 %}
-<div class="gallery">
+<div class="gallery{% if photos.size == 1 %} single{% endif %}">
   {% for photo in photos %}
   <figure>
-    <img src="{{ '/assets/img/personal/' | append: photo.file | relative_url }}" alt="{{ photo.caption | escape }}" loading="lazy">
+    <img src="{{ '/assets/img/personal/' | append: photo.file | relative_url }}" alt="{{ photo.caption | default: "Photo of Oliver" | escape }}" loading="lazy">
     {% if photo.caption %}<figcaption>{{ photo.caption }}</figcaption>{% endif %}
   </figure>
   {% endfor %}
diff --git a/assets/css/main.css b/assets/css/main.css
index 0f3ad4f..6f987e4 100644
